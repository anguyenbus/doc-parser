# AWS Bedrock configuration
# Required: the AWS region where Bedrock is enabled
AWS_REGION=ap-southeast-2

# Required: Bedrock model ID. Latest Sonnet, verified working in ap-southeast-2
# (2026-06-30) via the au.* cross-region inference profile:
#   au.anthropic.claude-sonnet-4-6  ← latest Sonnet (inference profile; verified via invoke_model)
# Note: the au.* inference-profile SCP block recorded on 2026-05-28 no longer applies —
# au.* profiles now resolve for this role (apac.* still returns ValidationException).
BEDROCK_VLM_MODEL=au.anthropic.claude-sonnet-4-6

# Escalation engine for gate-promoted pages: vlm | textract (default: vlm).
# Docling still handles confident pages either way; this only changes WHICH engine
# parses pages the quality gate promotes to escalation.
#   vlm      - Bedrock Claude Sonnet (BEDROCK_VLM_MODEL above). The default.
#   textract - AWS Textract synchronous AnalyzeDocument (FeatureTypes LAYOUT+TABLES),
#              passing the rendered page bytes directly (no S3, no async). Reuses the
#              AWS_REGION above and the same instance-role credentials as the VLM.
# The default stays `vlm`; flipping it to `textract` is gated on the head-to-head eval.
PARSER_ESCALATION_ENGINE=vlm

# Where the page pipeline (scripts/parse_pages.py) keeps its files: a local
# directory, or an S3 prefix written as s3://bucket[/prefix]. Under it the pipeline
# writes work/<file id>/ (page files, attempts, page results; safe to expire with an
# S3 lifecycle rule) and out/<file id>/ (status.json and the stitched document).
# Required unless --work-dir is given, which overrides it. An s3:// location also
# needs AWS_REGION above. Credentials are never configured here: access comes from
# the instance or pod role. The value below is a placeholder.
PARSER_STORE_LOCATION=s3://your-bucket/your-prefix/

# Worker processes for the page pipeline (default: min(4, cpus // 2)). Each worker
# holds its own Docling models (about 2-3 GB peak on OCR pages). 0 runs the pages
# in the calling process, one at a time (debugging).
# PARSER_PAGE_WORKERS=4

# Attempt limit per page in the page pipeline (default: 3). A page that is not ok
# is retried on each re-run until it has used this many attempts.
PARSER_PAGE_MAX_ATTEMPTS=3

# Scan fast path: 1 | true to enable (default: off). When EVERY page of a file is a
# scan (no text layer), skip the Docling parse and go straight to the escalation
# engine. All-or-nothing: one text page keeps the normal path. Use only for known
# scan-only input. It is part of the config pinned in each file's manifest.
# PARSER_SCAN_FASTPATH=1

# Escalation arbitration: 1 | true to enable (default: off). After a page escalates,
# keep the Docling text when the engine's output fails the garble check and a clean
# Docling render exists. It is part of the config pinned in each file's manifest.
# PARSER_ESCALATION_ARBITRATION=1

# PDF rasterization resolution in DPI (default: 144).
# Higher DPI improves table crop quality but increases memory and VLM token usage.
PARSER_RENDER_DPI=144

# Megapixel ceiling for any rasterized PDF page (default: 40).
# A page whose projected bitmap exceeds this is rendered at a reduced scale
# instead, bounding memory regardless of the declared MediaBox size. Guards
# against gigapixel-MediaBox OOM bombs; leaves Letter/A4/A1 untouched.
PARSER_MAX_RENDER_MP=40

# PIL decompression-bomb ceiling for image inputs, in pixels (default: 128000000).
# Image.open() of an input above this raises instead of allocating. Above any
# realistic legitimate scan (600-DPI A3 ~= 70 MP).
PARSER_MAX_IMAGE_PIXELS=128000000

# Raw-input size cap in MB (default: 200). Files larger than this are rejected
# (stat-based, before any read or parse) with an input_too_large warning.
# CAVEAT: bounds the RAW input size only — NOT the post-decompression expansion
# of zip-based Office formats (a 200 MB XLSX can expand far past that inside
# Docling), nor Docling's ~1.6 GB/worker model working set. It is a sanity bound,
# not the pod memory budget; size the pod against Docling, not this value.
PARSER_MAX_INPUT_MB=200

# Per-file page cap. Pages beyond this limit are skipped with a page_unparseable warning.
PARSER_MAX_PAGES=2000

# Asyncio semaphore limit for parse_batch.py concurrency.
PARSER_CONCURRENCY=4

# Python logging level for all parser_service modules.
# Valid values: DEBUG, INFO, WARNING, ERROR
PARSER_LOG_LEVEL=INFO
