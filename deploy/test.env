# deploy/test.env — the one source of names and tags for the KServe scale test.
# Sourced by every script in deploy/scripts/. Every AWS resource the test creates
# is named from TEST_RUN_ID and carries the tags below; the teardown refuses
# anything that does not carry TestRun=$TEST_RUN_ID.

export AWS_REGION=ap-southeast-2
export AWS_ACCOUNT_ID=740349584216

export TEST_RUN_ID=docparser-kserve-20261003
export CLUSTER_NAME=$TEST_RUN_ID
export K8S_VERSION=1.34
export NAMESPACE=doc-parser

# Tags (lib.sh renders them for eksctl, ECR and CloudWatch Logs).
export TAG_PROJECT=doc-parser
export TAG_OWNER=an-nguyen
export TAG_PURPOSE=kserve-scale-test
export TAG_EXPIRES_AT=2026-10-04

# Existing roles: this account cannot create IAM roles.
export CLUSTER_ROLE_ARN=arn:aws:iam::740349584216:role/ato-role-eks-cluster-sdpaap-genai-poc-de
export NODE_ROLE_ARN=arn:aws:iam::740349584216:role/ato-role-instance-sdpaap-genai-poc-de-instance-profile

# Network: the default VPC's public subnets (the private ones have no NAT).
export VPC_ID=vpc-0cca2a182dde486ac
export SUBNET_A=subnet-09817b2362ae73059
export SUBNET_B=subnet-07dc4fa1a8dca75fc
export SUBNET_C=subnet-042e25b266d36cb18
# The only address allowed on the public API endpoint: this dev box.
export API_ALLOWED_CIDR=13.55.171.190/32

# Node groups.
export SYSTEM_INSTANCE_TYPE=m6i.large
export PARSER_INSTANCE_TYPE=c6i.4xlarge
export PARSER_NODES_MIN=1
export PARSER_NODES_MAX=6

# Image.
export ECR_REPO=$TEST_RUN_ID/page-parser
export IMAGE_TAG=dev
export ECR_REGISTRY=$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com
export IMAGE_URI=$ECR_REGISTRY/$ECR_REPO:$IMAGE_TAG

# Store: everything the test writes in S3 is under this prefix.
export S3_PREFIX=s3://de-genai-dev/parser/$TEST_RUN_ID
export STORE_LOCATION=$S3_PREFIX/store
export INPUT_PREFIX=$S3_PREFIX/input
export BEDROCK_VLM_MODEL=au.anthropic.claude-sonnet-4-6

# Page service sizing.
export PREDICTOR_MIN_REPLICAS=1
export PREDICTOR_MAX_REPLICAS=30
# A busy pod (one page at a time) uses ~1 of its 2 requested CPUs, ~50%; the
# target must sit below that or the HPA never scales past a few pods (found in T2).
export PREDICTOR_TARGET_CPU=40
export DRIVER_CONCURRENCY=8

# Pinned versions of what runs in the cluster.
export KSERVE_VERSION=v0.21.0
export CERT_MANAGER_VERSION=v1.21.2
export CLUSTER_AUTOSCALER_TAG=v1.34.5

# Where the evidence goes (relative to the repo root).
export EVIDENCE_DIR=results/kserve_scale_20261003

# KServe v0.21.0 is installed from the chart tarballs attached to its GitHub
# release (the release named them -rc1 and never pushed v0.21.0 charts to
# ghcr.io); kserve.version pins the controller image to v0.21.0. Checksums
# verified at download.
export KSERVE_CHART_URL=https://github.com/kserve/kserve/releases/download/v0.21.0
export KSERVE_CRD_CHART=helm-chart-kserve-crd-v0.21.0-rc1.tgz
export KSERVE_CRD_CHART_SHA256=20751a25fe49b082b36e78cf7e9f707a7ed516db9c4bac4be53dc143f0464d4d
export KSERVE_RESOURCES_CHART=helm-chart-kserve-resources-v0.21.0-rc1.tgz
export KSERVE_RESOURCES_CHART_SHA256=3d6174ef0833ef4e281732bfe213a43cd55a54da6059f984c578cb1efaeb86e3
export CLUSTER_AUTOSCALER_CHART_VERSION=9.59.0
export NODE_ROLE_NAME=${NODE_ROLE_ARN##*/}
